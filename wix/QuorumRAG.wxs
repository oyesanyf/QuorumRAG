<?xml version="1.0" encoding="UTF-8"?>
<?ifndef ProductVersion ?>
<?define ProductVersion = "0.6.9" ?>
<?endif ?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
    <Package Name="QuorumRAG P2P Agentic RAG"
             Manufacturer="Oshoosi Security"
             Version="$(var.ProductVersion)"
             UpgradeCode="6c84d2a1-9f3b-47e2-b815-3d9a7e4c102f"
             Scope="perMachine">

        <MajorUpgrade AllowDowngrades="yes" Schedule="afterInstallExecute" />
        <MediaTemplate EmbedCab="yes" />

        <!-- Fail fast when the installer session is not elevated. Unprivileged runs of this
             package previously failed deep inside the MajorUpgrade sequence with status 1603
             and Error 1730 ("You must be an Administrator to remove this application") when
             RemoveExistingProducts had to uninstall an older QuorumRAG product. -->
        <Launch Condition="Privileged OR Installed"
                Message="QuorumRAG must be installed, repaired, or upgraded from an elevated (administrator) session. Right-click the MSI and choose 'Run as administrator', or run msiexec /i from an elevated terminal." />

        <!-- Universal Zero-Touch PATH Law:
             Strictly ZERO WiX Environment XML elements anywhere in this manifest.
             Launching relies exclusively on [INSTALLFOLDER] shortcuts and process-scoped launcher scripts. -->

        <StandardDirectory Id="ProgramFiles64Folder">
            <Directory Id="INSTALLFOLDER" Name="QuorumRAG">
                <Component Id="MainExecutable" Guid="a41f9c28-52d1-4b87-9e36-8172b5d409e1" Bitness="always64">
                    <File Id="QuorumRagExe" Source="target\release\quorumrag.exe" KeyPath="yes" />
                    <ServiceInstall Id="QuorumRagServiceInstall"
                                    Name="QuorumRAGDaemon"
                                    DisplayName="QuorumRAG Local-First P2P RAG Service"
                                    Description="QuorumRAG Local-First P2P Retrieval-Augmented Generation Daemon and Web UI"
                                    Type="ownProcess"
                                    Start="auto"
                                    ErrorControl="normal"
                                    Account="LocalSystem"
                                    Arguments="--service --host 0.0.0.0 --port 3031 --p2p-port 3032 --data-dir &quot;[CommonAppDataFolder]QuorumRAG\data&quot; --no-browser"
                                    Vital="yes" />
                    <!-- Started at install, stopped before upgrade/uninstall, and deleted from the
                         Service Control Manager on uninstall (Remove="uninstall"). -->
                    <ServiceControl Id="QuorumRagServiceControl"
                                    Name="QuorumRAGDaemon"
                                    Start="install"
                                    Stop="both"
                                    Remove="uninstall"
                                    Wait="yes" />
                </Component>

                <Component Id="LauncherScript" Guid="b72e8d39-63e2-4c98-af47-9283c6e51af2" Bitness="always64">
                    <File Id="QuorumLaunchCmd" Source="packaging\windows\quorumrag-launch.cmd" KeyPath="yes" />
                </Component>

                <Component Id="OpenUiScript" Guid="f1c6a273-07d8-4f1b-b3e2-5a6c9d7e8f01" Bitness="always64">
                    <File Id="QuorumOpenUiCmd" Source="packaging\windows\quorumrag-open-ui.cmd" KeyPath="yes" />
                </Component>

                <Component Id="UninstallScript" Guid="0b7d4e92-3a5f-4c61-8e2d-6f9a1c3b5d72" Bitness="always64">
                    <File Id="QuorumUninstallCmd" Source="packaging\windows\quorumrag-uninstall.cmd" KeyPath="yes" />
                </Component>

                <Component Id="InstallReadme" Guid="c83f9e40-74f3-4da9-b058-0394d7f62ba3" Bitness="always64">
                    <File Id="ReadmeInstallTxt" Source="packaging\windows\README_INSTALL.txt" KeyPath="yes" />
                </Component>
            </Directory>
        </StandardDirectory>

        <StandardDirectory Id="ProgramMenuFolder">
            <Directory Id="ApplicationProgramsFolder" Name="QuorumRAG">
                <Component Id="StartMenuShortcuts" Guid="d94a0f51-85a4-4eba-9169-14a5e8073cb4" Bitness="always64">
                    <Shortcut Id="StartMenuLaunchShortcut"
                              Name="QuorumRAG Chat UI"
                              Description="Launch QuorumRAG Local-First P2P Agentic RAG Web UI"
                              Target="[INSTALLFOLDER]quorumrag-launch.cmd"
                              WorkingDirectory="INSTALLFOLDER" />
                    <!-- One-click complete removal: uninstalls the MSI, which stops and deletes
                         the QuorumRAGDaemon service and its firewall rule. -->
                    <Shortcut Id="StartMenuUninstallShortcut"
                              Name="Uninstall QuorumRAG"
                              Description="Stop and delete the QuorumRAG service and remove the application"
                              Target="[System64Folder]msiexec.exe"
                              Arguments="/x [ProductCode]" />
                    <RemoveFolder Id="CleanUpShortCutDir" Directory="ApplicationProgramsFolder" On="uninstall" />
                    <RegistryValue Root="HKLM"
                                   Key="Software\OshoosiSecurity\QuorumRAG"
                                   Name="StartMenuShortcutInstalled"
                                   Type="integer"
                                   Value="1"
                                   KeyPath="yes" />
                </Component>
            </Directory>
        </StandardDirectory>

        <StandardDirectory Id="DesktopFolder">
            <Component Id="DesktopShortcuts" Guid="ea5b1062-96b5-4fcb-a27a-25b6f9184dc5" Bitness="always64">
                <Shortcut Id="DesktopLaunchShortcut"
                          Name="QuorumRAG Chat UI"
                          Description="Launch QuorumRAG Local-First P2P Agentic RAG Web UI"
                          Target="[INSTALLFOLDER]quorumrag-launch.cmd"
                          WorkingDirectory="INSTALLFOLDER" />
                <RegistryValue Root="HKLM"
                               Key="Software\OshoosiSecurity\QuorumRAG"
                               Name="DesktopShortcutInstalled"
                               Type="integer"
                               Value="1"
                               KeyPath="yes" />
            </Component>
        </StandardDirectory>

        <Feature Id="ProductFeature" Title="QuorumRAG Core Daemon &amp; Web UI" Level="1">
            <ComponentRef Id="MainExecutable" />
            <ComponentRef Id="LauncherScript" />
            <ComponentRef Id="OpenUiScript" />
            <ComponentRef Id="UninstallScript" />
            <ComponentRef Id="InstallReadme" />
            <ComponentRef Id="StartMenuShortcuts" />
            <ComponentRef Id="DesktopShortcuts" />
        </Feature>

        <!-- Scoped Private-LAN Firewall Rules for QuorumRAG P2P Mesh & libp2p mDNS/UDP/TCP
             Opt out during silent install via: msiexec /i QuorumRAG-0.6.9-x86_64.msi FIREWALLRULE=0 -->
        <Property Id="FIREWALLRULE" Value="1" Secure="yes" />
        <CustomAction Id="AddQuorumFirewallRule_In_Program"
                      Directory="System64Folder"
                      Execute="deferred"
                      Impersonate="no"
                      Return="ignore"
                      ExeCommand="&quot;[System64Folder]netsh.exe&quot; advfirewall firewall add rule name=&quot;QuorumRAG P2P Mesh (Program-In)&quot; dir=in action=allow program=&quot;[INSTALLFOLDER]quorumrag.exe&quot; enable=yes profile=any" />
        <CustomAction Id="AddQuorumFirewallRule_In_UDP"
                      Directory="System64Folder"
                      Execute="deferred"
                      Impersonate="no"
                      Return="ignore"
                      ExeCommand="&quot;[System64Folder]netsh.exe&quot; advfirewall firewall add rule name=&quot;QuorumRAG LAN Discovery (UDP 5353-In)&quot; dir=in action=allow protocol=UDP localport=5353 enable=yes profile=private" />
        <CustomAction Id="AddQuorumFirewallRule_Out_UDP"
                      Directory="System64Folder"
                      Execute="deferred"
                      Impersonate="no"
                      Return="ignore"
                      ExeCommand="&quot;[System64Folder]netsh.exe&quot; advfirewall firewall add rule name=&quot;QuorumRAG LAN Discovery (UDP 5353-Out)&quot; dir=out action=allow protocol=UDP localport=5353 enable=yes profile=private" />
        <CustomAction Id="AddQuorumFirewallRule_In_TCP"
                      Directory="System64Folder"
                      Execute="deferred"
                      Impersonate="no"
                      Return="ignore"
                      ExeCommand="&quot;[System64Folder]netsh.exe&quot; advfirewall firewall add rule name=&quot;QuorumRAG P2P Swarm (TCP 3032-In)&quot; dir=in action=allow protocol=TCP localport=3032 enable=yes profile=private" />
        <CustomAction Id="AddQuorumFirewallRule_Out_TCP"
                      Directory="System64Folder"
                      Execute="deferred"
                      Impersonate="no"
                      Return="ignore"
                      ExeCommand="&quot;[System64Folder]netsh.exe&quot; advfirewall firewall add rule name=&quot;QuorumRAG P2P Swarm (TCP 3032-Out)&quot; dir=out action=allow protocol=TCP remoteport=3032 enable=yes profile=private" />

        <CustomAction Id="RemoveQuorumFirewallRule_In_Program"
                      Directory="System64Folder"
                      Execute="deferred"
                      Impersonate="no"
                      Return="ignore"
                      ExeCommand="&quot;[System64Folder]netsh.exe&quot; advfirewall firewall delete rule name=&quot;QuorumRAG P2P Mesh (Program-In)&quot;" />
        <CustomAction Id="RemoveQuorumFirewallRule_In_UDP"
                      Directory="System64Folder"
                      Execute="deferred"
                      Impersonate="no"
                      Return="ignore"
                      ExeCommand="&quot;[System64Folder]netsh.exe&quot; advfirewall firewall delete rule name=&quot;QuorumRAG LAN Discovery (UDP 5353-In)&quot;" />
        <CustomAction Id="RemoveQuorumFirewallRule_Out_UDP"
                      Directory="System64Folder"
                      Execute="deferred"
                      Impersonate="no"
                      Return="ignore"
                      ExeCommand="&quot;[System64Folder]netsh.exe&quot; advfirewall firewall delete rule name=&quot;QuorumRAG LAN Discovery (UDP 5353-Out)&quot;" />
        <CustomAction Id="RemoveQuorumFirewallRule_In_TCP"
                      Directory="System64Folder"
                      Execute="deferred"
                      Impersonate="no"
                      Return="ignore"
                      ExeCommand="&quot;[System64Folder]netsh.exe&quot; advfirewall firewall delete rule name=&quot;QuorumRAG P2P Swarm (TCP 3032-In)&quot;" />
        <CustomAction Id="RemoveQuorumFirewallRule_Out_TCP"
                      Directory="System64Folder"
                      Execute="deferred"
                      Impersonate="no"
                      Return="ignore"
                      ExeCommand="&quot;[System64Folder]netsh.exe&quot; advfirewall firewall delete rule name=&quot;QuorumRAG P2P Swarm (TCP 3032-Out)&quot;" />
        <CustomAction Id="RemoveQuorumFirewallRule_Legacy"
                      Directory="System64Folder"
                      Execute="deferred"
                      Impersonate="no"
                      Return="ignore"
                      ExeCommand="&quot;[System64Folder]netsh.exe&quot; advfirewall firewall delete rule name=&quot;QuorumRAG P2P Mesh&quot;" />

        <!-- Open the Web UI in the installing user's browser when installation finishes.
             The script waits for the service health endpoint first. Disable with LAUNCHBROWSER=0. -->
        <Property Id="LAUNCHBROWSER" Value="1" Secure="yes" />
        <CustomAction Id="LaunchQuorumWebUi"
                      Directory="INSTALLFOLDER"
                      Execute="immediate"
                      Impersonate="yes"
                      Return="asyncNoWait"
                      ExeCommand="&quot;[System64Folder]cmd.exe&quot; /c &quot;&quot;[INSTALLFOLDER]quorumrag-open-ui.cmd&quot;&quot;" />

        <!-- Optional full data removal on uninstall: msiexec /x QuorumRAG-0.6.9-x86_64.msi REMOVEDATA=1
             deletes the index and logs in %ProgramData%\QuorumRAG (kept by default). -->
        <Property Id="REMOVEDATA" Value="0" Secure="yes" />
        <CustomAction Id="RemoveQuorumData"
                      Directory="System64Folder"
                      Execute="deferred"
                      Impersonate="no"
                      Return="ignore"
                      ExeCommand="&quot;[System64Folder]cmd.exe&quot; /c rmdir /s /q &quot;[CommonAppDataFolder]QuorumRAG&quot;" />

        <!-- Clean-replace law: an existing QuorumRAGDaemon registration or an orphaned
             quorumrag.exe process (including watch-p2p child) previously wedged installs
             with MSI Error 1921 ("Service ... could not be stopped").
             CRITICAL MSI SEQUENCING INVARIANT (ICE63 / Error 2613):
             Windows Installer forbids placing ANY deferred/script action between InstallInitialize
             and RemoveExistingProducts unless InstallExecute flushes the script immediately
             before RemoveExistingProducts. Therefore StopDeleteQuorumServiceUpgrade runs right
             after InstallInitialize, InstallExecute flushes it as SYSTEM, and RemoveExistingProducts
             immediately follows InstallExecute with zero intervening actions. -->
        <CustomAction Id="StopDeleteQuorumServiceUpgrade"
                      Directory="System64Folder"
                      Execute="deferred"
                      Impersonate="no"
                      Return="ignore"
                      ExeCommand="&quot;[System64Folder]cmd.exe&quot; /c [System64Folder]sc.exe stop QuorumRAGDaemon &amp; ping -n 5 127.0.0.1 &gt;nul &amp; [System64Folder]taskkill.exe /f /t /im quorumrag.exe &amp; ping -n 2 127.0.0.1 &gt;nul &amp; [System64Folder]sc.exe delete QuorumRAGDaemon" />
        <CustomAction Id="StopDeleteQuorumServiceUninstall"
                      Directory="System64Folder"
                      Execute="deferred"
                      Impersonate="no"
                      Return="ignore"
                      ExeCommand="&quot;[System64Folder]cmd.exe&quot; /c [System64Folder]sc.exe stop QuorumRAGDaemon &amp; ping -n 5 127.0.0.1 &gt;nul &amp; [System64Folder]taskkill.exe /f /t /im quorumrag.exe &amp; ping -n 2 127.0.0.1 &gt;nul &amp; [System64Folder]sc.exe delete QuorumRAGDaemon" />
        <!-- Fresh-install lock guarantee: terminate any leftover portable/console quorumrag.exe
             before file installation (anchored to System64Folder so working dir always exists). -->
        <CustomAction Id="KillQuorumOrphans"
                      Directory="System64Folder"
                      Execute="deferred"
                      Impersonate="no"
                      Return="ignore"
                      ExeCommand="&quot;[System64Folder]taskkill.exe&quot; /f /t /im quorumrag.exe" />

        <InstallExecuteSequence>
            <Custom Action="StopDeleteQuorumServiceUpgrade" After="InstallInitialize" Condition="WIX_UPGRADE_DETECTED AND NOT REINSTALL" />
            <InstallExecute After="StopDeleteQuorumServiceUpgrade" />
            <!-- Uninstall path: RemoveExistingProducts is never scheduled, so anchor before
                 StopServices/DeleteServices/RemoveFiles. Idempotent no-ops when nothing is left over. -->
            <Custom Action="StopDeleteQuorumServiceUninstall" Before="StopServices" Condition="REMOVE~=&quot;ALL&quot; AND NOT REINSTALL" />
            <Custom Action="KillQuorumOrphans" Before="InstallFiles" Condition="NOT Installed AND NOT WIX_UPGRADE_DETECTED AND NOT REINSTALL" />
            <Custom Action="AddQuorumFirewallRule_In_Program" After="InstallFiles" Condition="FIREWALLRULE=&quot;1&quot; AND NOT REMOVE~=&quot;ALL&quot;" />
            <Custom Action="AddQuorumFirewallRule_In_UDP" After="AddQuorumFirewallRule_In_Program" Condition="FIREWALLRULE=&quot;1&quot; AND NOT REMOVE~=&quot;ALL&quot;" />
            <Custom Action="AddQuorumFirewallRule_Out_UDP" After="AddQuorumFirewallRule_In_UDP" Condition="FIREWALLRULE=&quot;1&quot; AND NOT REMOVE~=&quot;ALL&quot;" />
            <Custom Action="AddQuorumFirewallRule_In_TCP" After="AddQuorumFirewallRule_Out_UDP" Condition="FIREWALLRULE=&quot;1&quot; AND NOT REMOVE~=&quot;ALL&quot;" />
            <Custom Action="AddQuorumFirewallRule_Out_TCP" After="AddQuorumFirewallRule_In_TCP" Condition="FIREWALLRULE=&quot;1&quot; AND NOT REMOVE~=&quot;ALL&quot;" />
            <Custom Action="RemoveQuorumFirewallRule_In_Program" Before="RemoveFiles" Condition="REMOVE~=&quot;ALL&quot;" />
            <Custom Action="RemoveQuorumFirewallRule_In_UDP" Before="RemoveFiles" Condition="REMOVE~=&quot;ALL&quot;" />
            <Custom Action="RemoveQuorumFirewallRule_Out_UDP" Before="RemoveFiles" Condition="REMOVE~=&quot;ALL&quot;" />
            <Custom Action="RemoveQuorumFirewallRule_In_TCP" Before="RemoveFiles" Condition="REMOVE~=&quot;ALL&quot;" />
            <Custom Action="RemoveQuorumFirewallRule_Out_TCP" Before="RemoveFiles" Condition="REMOVE~=&quot;ALL&quot;" />
            <Custom Action="RemoveQuorumFirewallRule_Legacy" Before="RemoveFiles" Condition="REMOVE~=&quot;ALL&quot;" />
            <Custom Action="RemoveQuorumData" After="RemoveFiles" Condition="REMOVE~=&quot;ALL&quot; AND REMOVEDATA=&quot;1&quot; AND NOT UPGRADINGPRODUCTCODE" />
            <Custom Action="LaunchQuorumWebUi" After="InstallFinalize" Condition="LAUNCHBROWSER=&quot;1&quot; AND NOT REMOVE~=&quot;ALL&quot;" />
        </InstallExecuteSequence>
    </Package>
</Wix>
